# Exact public HTTPS origin advertised to MCP/GPT Actions and remote runners.
# Do not include a trailing slash.
WEBCODEX_PUBLIC_URL=https://webcodex.example.com

# Required. Generate with: openssl rand -hex 32
# The security-hardened Server refuses to start without this value unless the
# explicit local-development escape hatch is enabled.
WEBCODEX_TOKEN=replace-with-a-long-random-secret

# Local address consumed by your existing host reverse proxy.
WEBCODEX_HOST_IP=127.0.0.1
WEBCODEX_HOST_PORT=8080

RUST_LOG=info
WEBCODEX_MCP_MODEL_SURFACE=local-coding-v1

# Security-hardened fork: compose.yaml never pulls the upstream mutable latest
# image by default. Build this checkout explicitly with:
#   docker compose -f compose.yaml -f compose.build.yaml build
#   docker compose -f compose.yaml -f compose.build.yaml up -d
# The default local image name is webcodex-server-local:security-hardened.
# To use another image, set WEBCODEX_SERVER_IMAGE to an audited immutable ref.
#
# Full semantic tool tracing can retain file contents, command output, and other
# payload data. If you intentionally enable it, acknowledge that retention too:
# WEBCODEX_TOOL_REQUEST_TRACE=full
# WEBCODEX_ALLOW_FULL_PAYLOAD_TRACE=true
#
# The unauthenticated bootstrap escape hatch is intentionally absent here.
# Do not enable WEBCODEX_ALLOW_UNAUTHENTICATED_BOOTSTRAP on a networked Server.
